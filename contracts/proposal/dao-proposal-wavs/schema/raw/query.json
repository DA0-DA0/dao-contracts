{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "description": "Query messages. Mirrors dao-proposal-single's surface where applicable; embeds the canonical service-handler queries via `#[serde(untagged)]`.",
  "oneOf": [
    {
      "description": "Returns the proposal-module Config.",
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns the total number of proposals ever submitted.",
      "type": "object",
      "required": [
        "proposal_count"
      ],
      "properties": {
        "proposal_count": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns a single proposal by id.",
      "type": "object",
      "required": [
        "proposal"
      ],
      "properties": {
        "proposal": {
          "type": "object",
          "required": [
            "proposal_id"
          ],
          "properties": {
            "proposal_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns a paginated list of proposals.",
      "type": "object",
      "required": [
        "list_proposals"
      ],
      "properties": {
        "list_proposals": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Returns whether a given event_id has already been seen (replay check).",
      "type": "object",
      "required": [
        "event_id_seen"
      ],
      "properties": {
        "event_id_seen": {
          "type": "object",
          "required": [
            "event_id_hex"
          ],
          "properties": {
            "event_id_hex": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "WAVS service-handler interface — exposes `WavsServiceManager {}` query. Returns `cosmwasm_std::Addr` (the configured service-manager address).",
      "type": "object",
      "required": [
        "service_handler"
      ],
      "properties": {
        "service_handler": {
          "$ref": "#/definitions/ServiceHandlerQueryMessages"
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ServiceHandlerQueryMessages": {
      "description": "The query-side message a service-handler exposes for \"where's my service-manager\".",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "wavs_service_manager"
          ],
          "properties": {
            "wavs_service_manager": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
