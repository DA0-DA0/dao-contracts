  "migrate": null,
  "sudo": null,
  "responses": {
    "gauge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GaugeResponse",
      "description": "Information about one gauge",
      "type": "object",
      "required": [
        "adapter",
        "epoch_size",
        "id",
        "is_stopped",
        "max_options_selected",
        "next_epoch",
        "title"
      ],
      "properties": {
        "adapter": {
          "description": "Address of contract to serve gauge-specific info (AdapterQueryMsg)",
          "type": "string"
        },
        "epoch_size": {
          "description": "Frequency (in seconds) the gauge executes messages, typically something like 7*86400",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "is_stopped": {
          "description": "True if the gauge is stopped",
          "type": "boolean"
        },
        "max_available_percentage": {
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_options_selected": {
          "description": "Maximum number of Options to make the selected set. Needed even with `min_percent_selected` to provide some guarantees on gas usage of this query.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "min_percent_selected": {
          "description": "Minimum percentage of votes needed by a given option to be in the selected set. If unset, there is no minimum percentage, just the `max_options_selected` limit.",
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_epoch": {
          "description": "UNIX time (seconds) when next epoch may be executed. May be future or past",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reset": {
          "description": "Set this in migration if the gauge should be periodically reset",
          "anyOf": [
            {
              "$ref": "#/definitions/Reset"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "description": "Name of the gauge (for UI)",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Decimal": {
          "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
          "type": "string"
        },
        "Reset": {
          "type": "object",
          "required": [
            "next",
            "reset_each"
          ],
          "properties": {
            "last": {
              "description": "until the first reset, this is None - needed for 0-cost migration from current state",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "next": {
              "description": "next time we can reset",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "reset_each": {
              "description": "seconds between reset",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      }
    },
    "info": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "InfoResponse",
      "type": "object",
      "required": [
        "info"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/ContractVersion"
        }
      },
      "additionalProperties": false,
      "definitions": {
        "ContractVersion": {
          "type": "object",
          "required": [
            "contract",
            "version"
          ],
          "properties": {
            "contract": {
              "description": "contract is the crate name of the implementing contract, eg. `crate:cw20-base` we will use other prefixes for other languages, and their standard global namespacing",
              "type": "string"
            },
            "version": {
              "description": "version is any string that this implementation knows. It may be simple counter \"1\", \"2\". or semantic version on release tags \"v0.7.0\", or some custom feature flag list. the only code that needs to understand the version parsing is code that knows how to migrate from the given contract (and is tied to it's implementation somehow)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "last_executed_set": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LastExecutedSetResponse",
      "description": "List the options that were selected in the last executed set.",
      "type": "object",
      "properties": {
        "votes": {
          "description": "`None` if no vote has been executed yet",
          "type": [
            "array",
