            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "is_stopped": {
              "description": "True if the gauge is stopped",
              "type": "boolean"
            },
            "max_available_percentage": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Decimal"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_options_selected": {
              "description": "Maximum number of Options to make the selected set. Needed even with `min_percent_selected` to provide some guarantees on gas usage of this query.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "min_percent_selected": {
              "description": "Minimum percentage of votes needed by a given option to be in the selected set. If unset, there is no minimum percentage, just the `max_options_selected` limit.",
              "anyOf": [
